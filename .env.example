# .env.example -> .env dosyasının ÖRNEĞİ. Bu dosya GitHub'a gider, içinde gerçek şifre YOKTUR.
# Kullanım: bu dosyayı kopyalayıp adını ".env" yapın ve değerleri doldurun.

FLASK_ENV=development
SECRET_KEY=buraya-uzun-rastgele-bir-metin-yazin

# Hafta 4'te doldurulacak (PostgreSQL bağlantısı)
DATABASE_URL=postgresql://postgres:sifreniz@localhost:5432/belgematik

# Hafta 7'de doldurulacak (yapay zekâ API anahtarı)
AI_API_KEY=
